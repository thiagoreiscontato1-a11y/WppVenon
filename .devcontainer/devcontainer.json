{
  "name": "WppVenon",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "runArgs": [
    "--shm-size=1g"
  ],
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "containerEnv": {
    "CHROME_PATH": "/usr/bin/chromium",
    "PUPPETEER_SKIP_DOWNLOAD": "1",
    "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "1",
    "TRUST_PROXY": "1"
  },
  "postCreateCommand": "bash scripts/codespace-setup.sh",
  "postAttachCommand": "bash scripts/codespace-start.sh",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "WppVenon",
      "onAutoForward": "notify"
    }
  }
}
